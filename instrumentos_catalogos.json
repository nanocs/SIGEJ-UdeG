 "CUCosta", "CUCSur", "CULagos", "CUTonalá", "SEMS", "UDG Virtual", "Hospital Civil de Guadalajara", "FIL", "FICG", "Auditorio Telmex", "Conjunto Santander", "MUSA", "Editorial Universitaria", "Fundación UdeG", "Entidades Productivas", "Fideicomisos", "Institutos y Centros de Investigación", "Organismos vinculados"], "fuentes": ["Recursos propios", "Recursos federales", "Recursos estatales", "Recursos concurrentes", "Recursos internacionales", "Mixto", "No aplica"], "estados": ["Solicitud", "Elaboración", "Revisión jurídica", "Aprobación", "Firma", "Vigente", "Por vencer", "Vencido", "Terminado", "Cancelado"], "oblig": ["Entregable", "Pago", "Garantía", "Informe", "Prórroga", "Renovación"], "riesgos_cat": ["Jurídico", "Financiero", "Operativo", "Reputacional", "Auditoría", "Transparencia", "Datos personales", "Corrupción"], "roles": [[90, "Abogado General"], [80, "Secretaría General"], [70, "Directores"], [60, "Coordinador General"], [50, "Coordinadores"], [40, "Jefes"], [30, "Abogados"], [20, "Analistas"], [10, "Asistentes"]], "raci": [["R", "Responsable — ejecuta / elabora"], ["A", "Aprueba — autoriza el instrumento"], ["C", "Consultado — opina antes de decidir"], ["I", "Informado — se le notifica el resultado"]], "clausulas": [{"clave": "CL-OBJ", "titulo": "Objeto", "fam": "General", "riesgo": "Bajo", "texto": "El presente instrumento tiene por objeto establecer las bases y mecanismos de colaboración entre LAS PARTES para [describir objeto], conforme a las disposiciones aplicables y al marco normativo de la Universidad de Guadalajara."}, {"clave": "CL-VIG", "titulo": "Vigencia", "fam": "General", "riesgo": "Medio", "texto": "El presente instrumento entrará en vigor a partir de la fecha de su firma y tendrá una vigencia de [periodo], pudiendo prorrogarse por acuerdo escrito de LAS PARTES suscrito con al menos 30 días naturales de anticipación a su vencimiento."}, {"clave": "CL-CONF", "titulo": "Confidencialidad", "fam": "Confidencialidad", "riesgo": "Alto", "texto": "LAS PARTES se obligan a mantener bajo estricta confidencialidad la información intercambiada con motivo del presente instrumento, y a no divulgarla a terceros sin consentimiento previo y por escrito, obligación que subsistirá por [periodo] posterior a su terminación."}, {"clave": "CL-PI", "titulo": "Propiedad intelectual", "fam": "Propiedad intelectual", "riesgo": "Alto", "texto": "La titularidad de los derechos de propiedad intelectual que se generen se regirá por la Ley Federal del Derecho de Autor y la Ley Federal de Protección a la Propiedad Industrial; los derechos morales corresponderán a los autores y los patrimoniales se distribuirán conforme a la participación de LAS PARTES, reconociendo en todo caso la participación de la Universidad de Guadalajara."}, {"clave": "CL-DP", "titulo": "Protección de datos personales", "fam": "Datos personales", "riesgo": "Alto", "texto": "El tratamiento de datos personales se sujetará a la Ley General de Protección de Datos Personales en Posesión de Sujetos Obligados y a la normativa estatal y universitaria aplicable, limitándose a las finalidades del presente instrumento."}, {"clave": "CL-NOLAB", "titulo": "No relación laboral", "fam": "General", "riesgo": "Alto", "texto": "LAS PARTES reconocen que el personal que cada una designe para el cumplimiento del presente instrumento mantendrá su relación laboral exclusivamente con quien lo contrató, sin que se genere relación laboral alguna respecto de la otra parte ni responsabilidad solidaria o sustituta."}, {"clave": "CL-TERM", "titulo": "Terminación anticipada", "fam": "Terminación", "riesgo": "Medio", "texto": "Cualquiera de LAS PARTES podrá dar por terminado anticipadamente el presente instrumento mediante aviso por escrito con [días] de anticipación, sin perjuicio de concluir las actividades en curso y de cubrir las obligaciones devengadas."}, {"clave": "CL-CASO", "titulo": "Caso fortuito o fuerza mayor", "fam": "General", "riesgo": "Bajo", "texto": "Ninguna de LAS PARTES será responsable por el incumplimiento de las obligaciones derivado de caso fortuito o fuerza mayor, debiendo notificarlo a la otra parte dentro de los [días] siguientes a que ocurra."}, {"clave": "CL-GAR", "titulo": "Garantías", "fam": "Obra pública", "riesgo": "Alto", "texto": "EL CONTRATISTA otorgará garantía de cumplimiento por el [%] del monto total y, en su caso, garantía de vicios ocultos por el [%], mediante fianza expedida por institución autorizada a favor de la Universidad de Guadalajara."}, {"clave": "CL-ANTI", "titulo": "Anticorrupción y conflicto de interés", "fam": "General", "riesgo": "Alto", "texto": "LAS PARTES manifiestan que se conducirán con integridad, absteniéndose de prácticas indebidas en términos de la Ley General de Responsabilidades Administrativas, y declaran no encontrarse en supuesto de conflicto de interés."}, {"clave": "CL-JUR", "titulo": "Jurisdicción y competencia", "fam": "General", "riesgo": "Medio", "texto": "Para la interpretación y cumplimiento del presente instrumento, LAS PARTES se someten a la jurisdicción de los tribunales competentes en la Zona Metropolitana de Guadalajara, Jalisco, renunciando a cualquier otro fuero que pudiera corresponderles."}, {"clave": "CL-TRANS", "titulo": "Transparencia", "fam": "Transparencia", "riesgo": "Medio", "texto": "LAS PARTES reconocen que el presente instrumento es información pública en términos de la legislación de transparencia, por lo que podrá publicarse en versión pública previo testado de datos personales y de información reservada o confidencial."}], "flujos": {"Convenios": [["Solicitud", "Dependencia solicitante", "Jefa de Unidad", "—", "OAG", 3, "Solicitud"], ["Asignación y elaboración", "Abogado", "Jefa de Unidad", "Dependencia solicitante", "—", 7, "Elaboración"], ["Revisión jurídica", "Abogado", "Coordinador Jurídico", "—", "Dependencia solicitante", 5, "Revisión jurídica"], ["Visto bueno superior", "Coordinador Jurídico", "Abogado General", "—", "—", 4, "Aprobación"], ["Fi